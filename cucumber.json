{
  "default": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "paths": [
      "src/features/**/*.feature"
    ],
    "publishQuiet": true,
    "import": [
      "src/step-definitions/**/*.ts",
      "src/support/**/*.ts"
    ],
    "format": [
      "progress-bar",
      "html:test-results/cucumber-report.html",
      "json:test-results/cucumber-report.json"
    ]
  }
}
